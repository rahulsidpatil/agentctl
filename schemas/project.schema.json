{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahulsidpatil/agentctl/schemas/project.schema.json",
  "title": "agentctl project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "instructions", "validation", "providers", "handoff"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "instructions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "validation": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "providers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"checkpoint_minutes": {"type": "integer", "minimum": 1}}
    }
  }
}
